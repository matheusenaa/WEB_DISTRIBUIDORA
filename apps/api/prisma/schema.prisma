// =====================================================================
// WEB DISTRIBUIDORA - Schema do banco de dados
// =====================================================================
// Convencoes:
//  * Todo valor monetario e INTEGER em CENTAVOS. Nunca float.
//  * Strings usadas como enum (SQLite nao suporta enum nativo).
//    Ao migrar para PostgreSQL, converter para enum nativo.
//  * Datas sao DateTime em UTC. Fuso do negocio e aplicado na borda.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// USUARIOS E AUTENTICACAO
// ---------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         String    @default("VENDEDOR") // ADMIN | VENDEDOR
  status       String    @default("ATIVO") // ATIVO | BLOQUEADO
  commissionPercent Int  @default(0)
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesAsSeller   Sale[]           @relation("SaleSeller")
  salesAsOperator Sale[]           @relation("SaleOperator")
  stockMovements  StockMovement[]
  cashSessions    CashSession[]
  cashMovements   CashMovement[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  purchaseOrders  PurchaseOrder[]
  backups         BackupRecord[]

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Tokens de renovacao persistidos para permitir revogacao (logout real).
model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------
// CADASTROS
// ---------------------------------------------------------------------

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([active])
  @@map("categories")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([active])
  @@map("brands")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  // --- Dados de reposicao (alimentam a sugestao de recompra) ---
  /// Prazo medio de entrega em dias, do pedido ate o recebimento.
  leadTimeDays Int   @default(0)
  /// Quantidade minima que o fornecedor aceita por pedido (0 = sem minimo).
  minOrderQuantity Int @default(0)
  /// Ultimo preco unitario pago e data da ultima compra.
  /// Mantidos desnormalizados para a lista de recompra nao exigir JOIN.
  lastPurchasePrice Int?
  lastPurchaseAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([active])
  @@map("suppliers")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([name])
  @@index([document])
  @@map("customers")
}

// ---------------------------------------------------------------------
// PRODUTOS
// ---------------------------------------------------------------------

model Product {
  id               Int     @id @default(autoincrement())
  internalCode     String? @unique
  barcode          String? @unique
  name             String
  description      String?
  categoryId       Int?
  brandId          Int?
  supplierId       Int?
  costPrice        Int     @default(0) // centavos
  salePrice        Int     @default(0) // centavos
  stock            Int     @default(0)
  minStock         Int     @default(0)
  maxStock         Int?
  unit             String  @default("UN")
  status           String  @default("ATIVO") // ATIVO | INATIVO
  saleObservation  String?
  /// Endereco no deposito: corredor/prateleira/caixa. Ajuda o Picking.
  location         String?
  /// Data da ultima venda concluida. Desnormalizada de proposito: a analise
  /// de "produtos parados" roda sobre toda a base e um JOIN com sale_items
  /// seria caro. Mantida pela transacao de venda.
  lastSaleAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@index([name])
  @@index([barcode])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([stock])
  @@index([location])
  /// Indice parcial equivalente para os filtros de alerta de estoque, que
  /// sempre combinam `status = ATIVO` com comparacao de saldo.
  @@index([status, minStock, stock])
  /// Analise de produtos parados: filtra por status e ordena por ultima venda.
  @@index([status, lastSaleAt])
  @@map("products")
}

// ---------------------------------------------------------------------
// MOVIMENTACOES DE ESTOQUE
// ---------------------------------------------------------------------
// Registro imutavel e append-only. `previousStock`/`resultingStock`
// permitem reconstruir a historia exata de qualquer produto.

model StockMovement {
  id             Int      @id @default(autoincrement())
  type           String // ENTRADA | SAIDA | VENDA | CANCELAMENTO | AJUSTE | DEVOLUCAO | PERDA | TRANSFERENCIA_SAIDA | TRANSFERENCIA_ENTRADA
  productId      Int
  quantity       Int // sempre positivo; o `type` define o sinal
  previousStock  Int
  resultingStock Int
  reason         String
  documentNumber String?
  unitCost       Int?
  userId         Int
  saleId         Int?
  purchaseOrderId Int?
  createdAt      DateTime @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([saleId])
  @@index([purchaseOrderId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------
// COMPRAS
// ---------------------------------------------------------------------
// Registro do que foi pedido ao fornecedor. Alimenta a sugestao de
// recompra (prazo medio, ultimo preco, data da ultima compra) e
// permite Receipt Order transformar o pedido em movimentacoes de estoque.

model PurchaseOrder {
  id             Int       @id @default(autoincrement())
  number         Int       @unique
  supplierId     Int
  userId         Int
  status         String    @default("ABERTO") // ABERTO | RECEBIDO | CANCELADO
  /// Numero da nota fiscal do fornecedor (documento do XML/DANFE).
  documentNumber String?
  orderedAt      DateTime  @default(now())
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]
  movements StockMovement[]

  @@index([supplierId, orderedAt])
  @@index([status])
  @@index([orderedAt])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              Int   @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  productName     String // snapshot: sobrevive a renomeacao do produto
  unit            String
  quantity        Int
  /// Preco unitario pago, em centavos (_snapshot do momento da compra).
  unitCost        Int
  receivedQuantity Int?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------
// VENDAS
// ---------------------------------------------------------------------

model Sale {
  id                Int      @id @default(autoincrement())
  number            Int      @unique // sequencia incremental legivel
  sellerId          Int
  userId            Int
  customerId        Int?
  subtotal          Int      @default(0)
  discountCents     Int      @default(0)
  total             Int      @default(0)
  costTotal         Int      @default(0)
  paymentMethod     String
  amountPaidCents   Int      @default(0)
  changeCents       Int      @default(0)
  status            String   @default("CONCLUIDA") // CONCLUIDA | CANCELADA
  notes             String?
  canceledAt        DateTime?
  cancelReason      String?
  createdAt         DateTime @default(now())

  seller   User     @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  user     User     @relation("SaleOperator", fields: [userId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments SalePayment[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  cashSessionId  Int?
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@index([paymentMethod])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id              Int   @id @default(autoincrement())
  saleId          Int
  productId       Int
  productName     String // snapshot: sobrevive a renomeacao do produto
  productUnit     String
  barcode         String?
  quantity        Int
  unitPrice       Int
  costPrice       Int
  discountPercent Float  @default(0)
  discountCents   Int    @default(0)
  subtotal        Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// Forma como o pagamento foi efetivamente dividido (pix + dinheiro, etc.).
/// Permite evolucao sem alterar a tabela de vendas.
model SalePayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  method    String
  amountCents Int
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

// ---------------------------------------------------------------------
// CAIXA
// ---------------------------------------------------------------------

model CashSession {
  id                   Int       @id @default(autoincrement())
  status               String    @default("ABERTO") // ABERTO | FECHADO
  userId               Int
  initialAmountCents   Int       @default(0)
  expectedAmountCents  Int? // congelado no fechamento
  reportedAmountCents  Int?
  differenceCents      Int?
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  notes                String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements  CashMovement[]
  sales      Sale[]

  @@index([status])
  @@index([userId, openedAt])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          Int      @id @default(autoincrement())
  cashSessionId Int
  type        String // ENTRADA | SAIDA
  kind        String // VENDA | OUTRA_ENTRADA | DESPESA | PAGAMENTO | RETIRADA | SANGRIA | SUPRIMENTO | ESTORNO
  amountCents Int
  description String
  saleId      Int?
  userId      Int
  createdAt   DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cashSessionId, createdAt])
  @@index([type])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------
// AUDITORIA
// ---------------------------------------------------------------------

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  userName    String?
  action      String
  entity      String?
  entityId    String?
  description String
  before      String? // JSON serializado
  after       String? // JSON serializado
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// CONFIGURACOES
// ---------------------------------------------------------------------

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------
// BACKUPS
// ---------------------------------------------------------------------
// Registro dos backups gerados. O arquivo .db.gz vive no disco; esta
// tabela guarda o historico para a tela de Configuracoes e para a
// retencao automatica, sem precisar varrer a pasta a cada listagem.

model BackupRecord {
  id         Int      @id @default(autoincrement())
  fileName   String   @unique
  sizeBytes  Int      @default(0)
  kind       String   @default("MANUAL") // MANUAL | AUTOMATICO | PRE_RESTORE
  status     String   @default("VALIDO") // VALIDO | INVALIDO | RESTAURADO
  userId     Int?
  note       String?
  checksum   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@map("backups")
}
