# ============================================================
# WEB DISTRIBUIDORA - Variaveis de Ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env
# ============================================================

# ---------- Ambiente ----------
NODE_ENV=development
TZ=America/Sao_Paulo

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=3333
# URL publica da API. Em dev, deixe igual ao host do frontend.
API_PUBLIC_URL=http://localhost:3333
# Origens autorizadas do frontend (separadas por virgula, sem barra final)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

# ---------- Banco de dados ----------
# SQLite (padrao - ideal para loja unica, backup = copia do arquivo)
DATABASE_URL="file:./dev.db"
# PostgreSQL (producao / multiplos caixas / multiplos PCs gravando)
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/webdistribuidora?schema=public"

# ---------- Autenticacao ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_PEPPER=
# Rotas publicas (nao exigem autenticacao)
PUBLIC_ROUTES=/api/auth/login,/api/auth/refresh,/api/health,/api/meta

# ---------- Usuario administrador inicial (criado pelo seed) ----------
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@webdistribuidora.com.br
ADMIN_PASSWORD=ChangeMe123!

# ---------- Regras de negocio ----------
# Permitir venda com estoque negativo
ALLOW_NEGATIVE_STOCK=false
# Desconto maximo em % que um VENDEDOR pode aplicar sem autorizacao
SELLER_MAX_DISCOUNT_PERCENT=0
# Desconto maximo em % que um ADMINISTRADOR pode aplicar
ADMIN_MAX_DISCOUNT_PERCENT=40
# Tolerancia de divergencia de caixa (R$) para considerar o caixa fechado
CASH_TOLERANCE=0.01
# Prazo de expiracao do cache de produto por codigo de barras (segundos)
BARCODE_CACHE_TTL_SECONDS=60

# ---------- Seed ----------
# true: o seed cria vendas de demonstracao. USE APENAS EM DESENVOLVIMENTO.
SEED_DEMO_SALES=false

# ---------- Frontend ----------
# Deve terminar com barra
VITE_API_URL=http://localhost:3333
